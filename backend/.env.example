PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/malogist
USE_MOCK_DB=true
JWT_SECRET=malogist-dev-secret
JWT_TTL=7d
# Background jobs (BullMQ). Off by default in non-production when unset; set REDIS_ENABLED=true if Redis runs locally.
REDIS_ENABLED=
REDIS_URL=redis://localhost:6379
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
